# Copy to Vercel / Render env (never commit real values)
OPENAI_API_KEY=
APIFY_TOKEN=
BRAVE_SEARCH_API_KEY=
LEADGEN_API_KEY=

# Render Postgres external URL (for Vercel serverless)
# Dashboard → leadgen-db → Connect → External Database URL
DATABASE_URL=postgresql://user:pass@host:5432/leadgen?sslmode=require

# Optional
JWT_SECRET=
REQUIRE_AUTH=auto
LEADGEN_MODEL=gpt-4o
USE_WATERFALL=false
